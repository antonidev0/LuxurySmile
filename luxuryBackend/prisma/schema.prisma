// Esquema de la base de datos (PostgreSQL)
// Tras cambiarlo: npx prisma migrate dev --name <nombre-del-cambio>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  doctor
  admin
}

enum Sex {
  hombre
  mujer
}

enum AppointmentStatus {
  pendiente
  confirmada
  cancelada
  completada
  no_asistio
}

// Tipos de entrada del historial de una cita
enum AppointmentEventType {
  creada       // la cita se registró (formulario web o nueva cita a partir de otra)
  estado       // cambio de estado (confirmar, cancelar, completar, no asistió)
  doctores     // se asignó, cambió o retiró un doctor
  reprogramada // cambio de fecha, hora o doctor desde el flujo de reprogramación
  nota         // nota administrativa (no es historia clínica)
}

// Personal de la clínica: administradores y odontólogos
model Staff {
  id           String   @id @default(cuid())
  name         String
  lastName     String
  numberId     String   @unique
  address      String
  numberPhone  String   @unique
  birthday     String
  sex          Sex
  specialty    String
  email        String   @unique
  passwordHash String
  role         Role     @default(doctor)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  // Fecha de baja: la cuenta queda desactivada pero se conservan sus datos y su historial
  deactivatedAt DateTime?
  // Horario semanal en el que atiende citas (solo doctores), por día de la semana:
  // { "1": { "start": "08:00", "end": "17:00" }, ... } (0 = domingo). Vacío = horario de la clínica
  availability  Json?

  // Citas en las que el doctor está asignado
  appointments Appointment[] @relation("AssignedDoctors")
}

model Appointment {
  id           String            @id @default(cuid())
  firstName    String
  lastName     String
  ci           String
  email        String
  // Solo el día (YYYY-MM-DD); la hora va aparte en "time"
  date         DateTime          @db.Date
  time         String
  status       AppointmentStatus @default(pendiente)
  historialPDF String?
  // Ficha clínica que usa la cita (puede ser una ficha creada en una cita anterior del paciente)
  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation("AppointmentRecord", fields: [medicalRecordId], references: [id], onDelete: SetNull)
  // Copia de los datos de los doctores al completar la cita,
  // para conservarlos aunque luego se elimine al doctor
  completedBy  Json?
  createdAt    DateTime          @default(now())
  // Si la cita se creó para reagendar una cancelada o una a la que el paciente no asistió
  previousAppointmentId String?
  previousAppointment   Appointment?  @relation("Rebooked", fields: [previousAppointmentId], references: [id])
  rebookedAs            Appointment[] @relation("Rebooked")

  assignedDoctors Staff[] @relation("AssignedDoctors")
  events          AppointmentEvent[]
  // Fichas clínicas creadas en esta cita
  createdRecords  MedicalRecord[] @relation("RecordOrigin")

  @@index([date])
}

// Historial de cambios de una cita. Solo se añaden entradas: la base de datos
// impide editarlas o borrarlas (ver la migración historial_citas).
model AppointmentEvent {
  id            String               @id @default(cuid())
  appointmentId String
  appointment   Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  type          AppointmentEventType
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus?
  // Copia de los doctores [{ id, name }] para que el historial no cambie si luego se edita su ficha
  fromDoctors   Json?
  toDoctors     Json?
  fromDate      DateTime?            @db.Date
  toDate        DateTime?            @db.Date
  fromTime      String?
  toTime        String?
  // Motivo de cancelación o reprogramación, o el texto de la nota
  reason        String?
  // Quién hizo el cambio (vacío si fue el paciente desde el formulario web)
  actorId       String?
  actorName     String
  actorRole     Role?
  createdAt     DateTime             @default(now())

  @@index([appointmentId, createdAt])
}

// Ficha clínica del paciente con el formato oficial de la clínica (assets/ficha-luxury-smile.pdf).
// Un paciente (por cédula) puede tener varias fichas: en cada consulta el doctor edita la última
// o crea una nueva. El PDF se vuelve a generar cada vez que se guarda la ficha.
model MedicalRecord {
  id            String        @id @default(cuid())
  // Cédula en mayúsculas y sin espacios, para agrupar las fichas del paciente
  patientCi     String
  // Cita en la que se creó la ficha
  appointmentId String
  appointment   Appointment   @relation("RecordOrigin", fields: [appointmentId], references: [id], onDelete: Restrict)
  // Datos de la ficha (ver sanitizeFicha en src/utils/ficha.js)
  data          Json
  pdfPath       String
  createdById   String?
  createdByName String
  updatedById   String?
  updatedByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointments  Appointment[] @relation("AppointmentRecord")

  @@index([patientCi, createdAt])
}
