# Copia este archivo como .env y rellena los valores
PORT=3003
NODE_ENV=development

# MongoDB
MONGO_URI_TEST=mongodb://localhost:27017/luxurysmile
MONGO_URI_PROD=

# JWT (usa una cadena larga y aleatoria)
