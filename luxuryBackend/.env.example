# Copia este archivo como .env y rellena los valores
PORT=3003
NODE_ENV=development

# PostgreSQL (Neon: Dashboard > Connect > copia la "connection string")
# Ejemplo local con Docker: postgresql://postgres:postgres@localhost:5432/luxurysmile
DATABASE_URL="postgresql://usuario:clave@servidor/luxurysmile?sslmode=require"

# JWT (usa una cadena larga y aleatoria)
JWT_SECRET=

# Correo (Gmail con contraseña de aplicación)
EMAIL_USER=
EMAIL_PASS=

# URL del frontend (CORS y enlaces de verificación)
CLIENT_ORIGIN=http://localhost:5173
PAGE_URL=http://localhost:5173
